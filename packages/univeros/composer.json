{
    "name": "univeros/orion",
    "description": "Orion as a Univeros module: one line in config/modules.php gives the host Orion on its Cycle connection, the migration, the orion:* commands and the doctor checks",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "keywords": [
        "univeros",
        "altair",
        "search",
        "elasticsearch",
        "opensearch",
        "meilisearch",
        "reindex",
        "outbox"
    ],
    "require": {
        "cycle/database": "^2.10",
        "cycle/migrations": "^4.2",
        "orion-search/cli": "^1.0",
        "orion-search/core": "^1.0",
        "orion-search/pdo": "^1.0",
        "orion-search/psr15": "^1.0",
        "php": ">=8.3",
        "univeros/configuration": "^2.6",
        "univeros/container": "^2.6",
        "univeros/module": "^2.6",
        "univeros/persistence": "^2.6"
    },
    "require-dev": {
        "orion-search/elasticsearch": "^1.0",
        "orion-search/meilisearch": "^1.0",
        "orion-search/opensearch": "^1.0",
        "orion-search/polaris": "^1.0",
        "orion-search/solr": "^1.0",
        "orion-search/testing": "^1.0",
        "univeros/doctor": "^2.6",
        "univeros/messaging": "^2.6",
        "univeros/observability": "^2.6"
    },
    "suggest": {
        "orion-search/elasticsearch": "ORION_ENGINE=elasticsearch with ORION_ELASTICSEARCH_URL",
        "orion-search/opensearch": "ORION_ENGINE=opensearch with ORION_OPENSEARCH_URL",
        "orion-search/solr": "ORION_ENGINE=solr with ORION_SOLR_URL",
        "orion-search/meilisearch": "ORION_ENGINE=meilisearch with ORION_MEILISEARCH_URL and ORION_MEILISEARCH_KEY",
        "orion-search/polaris": "With univeros/polaris, each request's tenant is its token's active organization",
        "univeros/doctor": "The seven Orion checks join bin/altair doctor, with --fix where it is safe",
        "univeros/messaging": "The drain runs on the bus worker after each commit instead of in the request",
        "univeros/observability": "Orion's counters and the outbox lag gauge go to the framework Meter",
        "univeros/mcp": "The orion__* tools (compile_query, search, list_indices, describe_index, capabilities, plan; apply and reindex gated) join bin/altair mcp:serve",
        "laminas/laminas-diactoros": "PSR-17 factories for the search: endpoints when the container binds none (the skeleton ships it)"
    },
    "autoload": {
        "psr-4": {
            "Univeros\\Orion\\": "src/",
            "Univeros\\Orion\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Univeros\\Orion\\Tests\\": "tests/",
            "Altair\\Mcp\\": "tests/Stubs/Altair/Mcp/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
