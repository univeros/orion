{
    "type": "object",
    "properties": {
        "index": {
            "type": "string",
            "description": "The index name (alias) as the manifest declares it."
        },
        "query": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "match",
                            "phrase",
                            "prefix",
                            "term"
                        ]
                    },
                    "field": {
                        "type": "string"
                    },
                    "fields": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "number"
                        },
                        "description": "Weights by field, instead of one field."
                    },
                    "value": {
                        "description": "Text for match, phrase and prefix; a string, number or boolean for term."
                    },
                    "boost": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    }
                },
                "required": [
                    "type",
                    "value"
                ],
                "additionalProperties": false
            },
            "maxItems": 64,
            "description": "Lexical clauses, all of which must match."
        },
        "vector": {
            "type": "object",
            "properties": {
                "field": {
                    "type": "string"
                },
                "vector": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "k": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "required": [
                "field",
                "vector",
                "k"
            ],
            "additionalProperties": false,
            "description": "k-NN over a vector field; with clauses, a hybrid query."
        },
        "fusion": {
            "type": "object",
            "properties": {
                "strategy": {
                    "type": "string",
                    "enum": [
                        "reciprocal_rank",
                        "weighted"
                    ]
                },
                "k": {
                    "type": "integer",
                    "minimum": 1
                },
                "lexical": {
                    "type": "number"
                },
                "vector": {
                    "type": "number"
                }
            },
            "required": [
                "strategy"
            ],
            "additionalProperties": false
        },
        "filters": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "term",
                            "terms",
                            "range",
                            "exists",
                            "bool"
                        ]
                    }
                },
                "required": [
                    "type"
                ]
            },
            "maxItems": 64,
            "description": "Filters by type: term (field, value), terms (field, values), range (field, gt/gte/lt/lte), exists (field), bool (must, should, must_not; at most 64 children each, 10 levels deep)."
        },
        "sort": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "field": {
                        "type": "string",
                        "description": "A sortable field, or _score."
                    },
                    "direction": {
                        "type": "string",
                        "enum": [
                            "asc",
                            "desc"
                        ]
                    }
                },
                "required": [
                    "field"
                ],
                "additionalProperties": false
            },
            "maxItems": 8
        },
        "facets": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "field": {
                        "type": "string"
                    },
                    "size": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "field"
                ],
                "additionalProperties": false
            },
            "maxItems": 16
        },
        "highlight": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "maxItems": 16
        },
        "page": {
            "type": "object",
            "properties": {
                "page": {
                    "type": "integer",
                    "minimum": 1
                },
                "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                }
            },
            "required": [
                "page",
                "size"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "index"
    ],
    "additionalProperties": false
}
