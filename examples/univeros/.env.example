APP_ENV=dev
APP_DEBUG=true

# Logging (PSR-3 via Monolog).
LOG_CHANNEL=app
LOG_LEVEL=warning
LOG_PATH=php://stderr
LOG_FORMAT=line

# The database Cycle and Orion share: Orion records its outbox on this connection, in the same transaction as the
# products. bin/setup makes the path absolute (the built-in server runs with public/ as its working directory).
DB_CONNECTION=sqlite
DB_DATABASE=var/orion.sqlite

# Orion. One tenant: there is no default, so the choice is written down.
ORION_TENANCY=single
# The engine: the module builds it from these two.
ORION_ENGINE=elasticsearch
ORION_ELASTICSEARCH_URL=http://127.0.0.1:9200
# The search: manifests (api/**/search.yaml); bin/setup makes the path absolute.
ORION_MANIFESTS=api
# Receipt signing: bin/setup generates a key pair and fills these in.
ORION_RECEIPT_KID=
ORION_RECEIPT_SECRET_KEY=
