<?xml version="1.0"?>
<ruleset name="Orion">
    <description>Orion coding standard (PSR-12).</description>

    <file>packages/core/src</file>
    <file>packages/core/tests</file>
    <file>packages/testing/src</file>
    <file>packages/pdo/src</file>
    <file>packages/pdo/tests</file>
    <file>packages/elasticsearch/src</file>
    <file>packages/elasticsearch/tests</file>
    <file>packages/cli/src</file>
    <file>packages/cli/tests</file>
    <file>packages/cli/bin</file>
    <file>packages/polaris/src</file>
    <file>packages/polaris/tests</file>
    <file>packages/univeros/src</file>
    <file>packages/univeros/tests</file>
    <file>packages/univeros/migrations</file>

    <arg name="colors"/>
    <arg name="warning-severity" value="0"/>
    <arg value="np"/>

    <rule ref="PSR12"/>
</ruleset>
