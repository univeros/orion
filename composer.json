{
    "name": "univeros/orion-monorepo",
    "description": "Orion: deterministic, replayable index lifecycle for any full-text engine, with a thin hybrid query layer, for any PHP application",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "homepage": "https://github.com/univeros/orion",
    "support": {
        "issues": "https://github.com/univeros/orion/issues",
        "source": "https://github.com/univeros/orion"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "orion-search/core": "0.1.x-dev",
                    "orion-search/testing": "0.1.x-dev",
                    "orion-search/pdo": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "orion-search/core": "0.1.x-dev",
        "orion-search/pdo": "0.1.x-dev",
        "orion-search/testing": "0.1.x-dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^3.13.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Orion\\Tests\\": "packages/core/tests/",
            "Orion\\Pdo\\Tests\\": "packages/pdo/tests/"
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse",
        "imports": "bin/check-imports",
        "test": "phpunit",
        "qa": [
            "@cs",
            "@stan",
            "@imports",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
