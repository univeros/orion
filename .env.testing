# Connection settings for the services in compose.yaml. Unset a variable to skip its suite.
ORION_PGSQL_DSN=pgsql:host=127.0.0.1;port=54329;dbname=orion;user=orion;password=orion
ORION_MYSQL_DSN=mysql:host=127.0.0.1;port=33069;dbname=orion
ORION_MYSQL_USER=root
ORION_MYSQL_PASSWORD=orion
ORION_ELASTICSEARCH_URL=http://127.0.0.1:59200
ORION_SOLR_URL=http://127.0.0.1:58983/solr
ORION_SOLR9_URL=http://127.0.0.1:58984/solr
# Needs client 8.19: composer update elasticsearch/elasticsearch elastic/transport --with=elasticsearch/elasticsearch:^8.19 -W
# ORION_ELASTICSEARCH8_URL=http://127.0.0.1:59201
