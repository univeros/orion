parameters:
    level: 8
    # Value objects re-check their phpdoc shapes at runtime (list, finite, element types): callers that do not run
    # phpstan reach them too. Narrowing still comes from native types.
    treatPhpDocTypesAsCertain: false
    paths:
        - packages/core/src
        - packages/core/tests
        - packages/testing/src
        - packages/pdo/src
        - packages/pdo/tests
        - packages/elasticsearch/src
        - packages/elasticsearch/tests
        - packages/cli/src
        - packages/cli/tests
        - packages/psr15/src
        - packages/psr15/tests
        - packages/solr/src
        - packages/solr/tests
        - packages/opensearch/src
        - packages/opensearch/tests
        - packages/meilisearch/src
        - packages/meilisearch/tests
        - packages/polaris/src
        - packages/polaris/tests
        - packages/univeros/src
        - packages/univeros/tests
        - packages/univeros/migrations
    excludePaths:
        # Verbatim copies of univeros/mcp contracts (see packages/univeros/tests/Stubs/README.md), not this code.
        - packages/univeros/tests/Stubs
