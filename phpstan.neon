parameters:
    level: 8
    # Value objects re-check their phpdoc shapes at runtime (list, finite, element types): callers that do not run
    # phpstan reach them too. Narrowing still comes from native types.
    treatPhpDocTypesAsCertain: false
    paths:
        - packages/core/src
        - packages/core/tests
        - packages/testing/src
        - packages/pdo/src
        - packages/pdo/tests
        - packages/elasticsearch/src
        - packages/elasticsearch/tests
        - packages/cli/src
        - packages/cli/tests
        - packages/univeros/src
        - packages/univeros/tests
        - packages/univeros/migrations
